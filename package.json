{
  "name": "inder",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/datetimepicker": "9.2.1",
    "expo": "~58.0.24",
    "expo-constants": "~58.0.14",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-sqlite": "~58.0.16",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "demo": "node scripts/serve-demo.mjs",
    "build:demo": "expo export --platform web",
    "verify": "npm run typecheck && npm run lint && npm test",
    "security:scan": "node scripts/security-check.mjs",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts tests/unit/*.test.ts",
    "test:unit": "node --experimental-strip-types --test tests/unit/*.test.ts tests/note-validation.test.ts tests/reminder-validation.test.ts",
    "test:integration": "node --experimental-strip-types --test tests/core.test.ts",
    "build": "expo export --platform ios --platform android --platform web",
    "lint": "expo lint"
  },
  "overrides": {
    "zod": "4.6.6"
  },
  "private": true
}
